# ============================================================
# SIS-MALI — Docker build ignore
# ============================================================
# Tout ce qui n'est PAS necessaire au build Docker.

# Dependencies (reinstallees dans le conteneur)
node_modules
*/node_modules
**/node_modules

# Git
.git
.gitignore
.gitattributes

# Build artifacts locaux
dist
build
apps/*/dist
apps/*/build

# On GARDE packages/shared/dist (utilise par l'API au build)
# Mais on exclut les caches TS
*.tsbuildinfo
**/*.tsbuildinfo

# Env (jamais dans l'image)
.env
.env.*
!.env.example

# Backups locaux
backups
*.bak
*.bak-*
*.tar.gz
*.sql.gz

# Storage (monte en volume)
storage

# Logs
*.log
logs

# IDE
.vscode
.idea
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Tests / docs
coverage
.nyc_output
*.test.ts
*.spec.ts
docs
*.md
!README.md

# Scripts Python temporaires
*.py
!scripts/*.py

# Divers
.cache
.tmp
*.tmp

# Backups locaux (ne pas copier dans le build context)
*.bak
*.bak-*
*.bak2-*
*.bak3-*
*.safety-*
*.safety2-*

# Logs et temp
*.log
tmp/
.npm/
