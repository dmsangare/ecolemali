# ============================================================
# SIS-MALI — Environment Variables
# ============================================================

# --- Application ---
NODE_ENV=development
APP_NAME=SIS-MALI
APP_URL=http://localhost
TZ=Africa/Bamako

# --- PostgreSQL ---
POSTGRES_DB=sis_mali
POSTGRES_USER=sis_user
POSTGRES_PASSWORD=SisMali_Dev_2026!Secure
POSTGRES_PORT=5432
DATABASE_URL=postgresql://sis_user:SisMali_Dev_2026!Secure@postgres:5432/sis_mali?schema=public

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# --- JWT ---
JWT_SECRET=a7f3c9e1b5d842f6a0c7e3b9d1f5a8c2e6b4d0f9a3c7e1b5d8f2a6c0e4b9d3f7
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=f9d3b7a1e5c8f2d6b0a4c9e3f7b1d5a8c2e6f0b4d8a3c7e1f5b9d2a6c0e4f8b3
JWT_REFRESH_EXPIRES_IN=7d

# --- Security ---
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCK_DURATION_MINUTES=15
RATE_LIMIT_PER_MINUTE=100

# --- Storage ---
STORAGE_ROOT=/app/storage
STORAGE_DOCUMENTS=/app/storage/documents
STORAGE_UPLOADS=/app/storage/uploads
STORAGE_BACKUPS=/app/storage/backups
STORAGE_GENERATED=/app/storage/generated
MAX_UPLOAD_SIZE_MB=10

# --- PDF ---
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
PDF_LOCALE=fr-FR

# --- Network ---
HTTP_PORT=80
HTTPS_PORT=443

# --- Backups ---
BACKUP_CRON=0 23 * * *
BACKUP_RETENTION_DAYS=7
BACKUP_RETENTION_WEEKS=4
BACKUP_RETENTION_MONTHS=12

# --- Notifications (optional, V2) ---
SMS_PROVIDER_URL=
SMS_PROVIDER_KEY=
WHATSAPP_PROVIDER_URL=
WHATSAPP_PROVIDER_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@sis-mali.local

# --- Defaults ---
DEFAULT_COUNTRY=ML
DEFAULT_TIMEZONE=Africa/Bamako
DEFAULT_CURRENCY=FCFA
DEFAULT_LOCALE=fr-FR
FRONTEND_URL=http://localhost:5173