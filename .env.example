# ============================================================
# SIS-MALI — Environment Variables (PRODUCTION TEMPLATE)
# ============================================================
# Copier ce fichier vers .env et remplir les valeurs réelles.
# NE JAMAIS COMMITTER le .env réel.
# ============================================================

# --- Application ---
NODE_ENV=production
APP_NAME=SIS-MALI
APP_URL=http://votre-domaine.ml
TZ=Africa/Bamako

# --- PostgreSQL ---
# ⚠️  Changer le mot de passe sur chaque serveur
POSTGRES_DB=sis_mali
POSTGRES_USER=sis_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
POSTGRES_PORT=5432
DATABASE_URL=postgresql://sis_user:CHANGE_ME_STRONG_PASSWORD_HERE@postgres:5432/sis_mali?schema=public

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# --- JWT ---
# ⚠️  Générer avec : openssl rand -hex 64
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_64

# URL publique pour QR codes et liens de verification
PUBLIC_URL=http://localhost
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_64_DIFFERENT
JWT_REFRESH_EXPIRES_IN=7d

# --- Security ---
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCK_DURATION_MINUTES=15
RATE_LIMIT_PER_MINUTE=100

# --- Storage ---
STORAGE_ROOT=/app/storage
STORAGE_DOCUMENTS=/app/storage/documents
STORAGE_UPLOADS=/app/storage/uploads
STORAGE_BACKUPS=/app/storage/backups
STORAGE_GENERATED=/app/storage/generated
MAX_UPLOAD_SIZE_MB=10

# --- PDF ---
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
PDF_LOCALE=fr-FR

# --- Network ---
HTTP_PORT=80
HTTPS_PORT=443

# --- Backups ---
BACKUP_CRON=0 23 * * *
BACKUP_RETENTION_DAYS=7
BACKUP_RETENTION_WEEKS=4
BACKUP_RETENTION_MONTHS=12

# --- Notifications (optionnel) ---
SMS_PROVIDER_URL=
SMS_PROVIDER_KEY=
WHATSAPP_PROVIDER_URL=
WHATSAPP_PROVIDER_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@sis-mali.local

# --- Defaults ---
DEFAULT_COUNTRY=ML
DEFAULT_TIMEZONE=Africa/Bamako
DEFAULT_CURRENCY=FCFA
DEFAULT_LOCALE=fr-FR
FRONTEND_URL=http://votre-domaine.ml

# --- Seed (premiere installation uniquement) ---
# Mot de passe initial des comptes crees par le seed.
# Laisser vide pour en generer un aleatoire (affiche une seule fois en fin de seed).
SEED_PASSWORD=
