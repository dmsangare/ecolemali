// ============================================================
// SIS-MALI — Schema Prisma complet
// PostgreSQL 16 — 47 tables — 33 enums
// ============================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Gender {
  M
  F
}

enum SchoolType {
  FONDAMENTAL
  PREMIER_CYCLE
  DEUXIEME_CYCLE
  LYCEE
  FONDAMENTAL_LYCEE
}

enum SchoolStatus {
  PUBLIC
  PRIVE
  CONFESSIONNEL
  LAIC
}

enum AcademicYearStatus {
  PREPARATION
  ACTIVE
  CLOTUREE
  ARCHIVEE
}

enum TermType {
  TRIMESTRE
  SEMESTRE
}

enum LevelCycle {
  PREMIER_CYCLE
  DEUXIEME_CYCLE
  LYCEE
}

enum ClassStatus {
  OPEN
  CLOSED
  ARCHIVED
}

enum RoomType {
  CLASSROOM
  LAB
  COMPUTER_ROOM
  LIBRARY
  MEETING_ROOM
  OTHER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
  PENDING
}

enum StudentStatus {
  ACTIVE
  TRANSFERRED
  GRADUATED
  DROPPED
  SUSPENDED
}

enum GuardianRelation {
  FATHER
  MOTHER
  TUTOR
  OTHER
}

enum DocumentType {
  BIRTH_CERTIFICATE
  SCHOOL_CERTIFICATE
  TRANSFER
  PHOTO
  OTHER
}

enum EnrollmentStatus {
  PENDING
  VALIDATED
  CANCELLED
  COMPLETED
}

enum PathwayResult {
  PASSED
  REPEATED
  EXCLUDED
  TRANSFERRED
}

enum TeacherStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ContractType {
  PERMANENT
  CONTRACT
  TEMPORARY
  VOLUNTEER
}

enum SubjectType {
  CORE
  OPTIONAL
  SPORT
  ART
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  ABSENT_JUSTIFIED
  ABSENT_UNJUSTIFIED
}

enum AssessmentType {
  INTERROGATION
  DEVOIR
  CONTROLE
  COMPOSITION
  EXAMEN
  TP
  ORAL
  PROJET
}

enum AssessmentStatus {
  DRAFT
  OPEN
  SUBMITTED
  VALIDATED
  LOCKED
}

enum ReportDecision {
  ADMIS
  PASSE
  REDOUBLE
  EXCLU
  A_DETERMINER
}

enum ReportStatus {
  DRAFT
  VALIDATED
  PUBLISHED
}

enum ExamType {
  INTERNE
  COMPOSITION
  BLANC
  FIN_ANNEE
}

enum ExamStatus {
  PLANNED
  ONGOING
  FINISHED
  CANCELLED
}

enum FeeCategory {
  INSCRIPTION
  SCOLARITE
  TRANSPORT
  CANTINE
  UNIFORME
  FOURNITURES
  EXAMEN
  AUTRE
}

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  TRANSFER
  CHECK
  MOBILE_MONEY
  OTHER
}

enum CashStatus {
  OPEN
  CLOSED
}

enum DocumentTemplateType {
  CERTIFICATE
  ATTESTATION
  RECEIPT
  REPORT_CARD
  TRANSCRIPT
  ENROLLMENT_FORM
  STUDENT_SHEET
  TRANSFER
  DECISION
  PV
  CLASS_LIST
}

enum NotificationType {
  ENROLLMENT
  ABSENCE
  LATE
  PAYMENT
  GRADES_PUBLISHED
  REPORT_AVAILABLE
  MEETING
  OTHER
}

enum NotificationChannel {
  INTERNAL
  SMS
  WHATSAPP
  EMAIL
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

enum BackupType {
  DB
  FILES
  FULL
}

enum BackupStatus {
  SUCCESS
  FAILED
  IN_PROGRESS
}

enum TransferType {
  IN
  OUT
}

enum TransferReason {
  DEMENAGEMENT
  PASSAGE
  DISCIPLINE
  FAMILIALE
  AUTRE
}

enum TransferStatus {
  PENDING
  VERIFIED
  REJECTED
  ARCHIVED
}



// ============================================================
// 1. BLOC ADMINISTRATION
// ============================================================

model School {
  id           String       @id @default(uuid()) @db.Uuid
  code         String       @unique @db.VarChar(20)
  sigle        String?      @db.VarChar(20)
  name         String       @db.VarChar(150)
  type         SchoolType
  status       SchoolStatus
  address      String?
  region       String?      @db.VarChar(100)
  cercle       String?      @db.VarChar(100)
  commune      String?      @db.VarChar(100)
  quarter      String?      @db.VarChar(100)
  phone        String?      @db.VarChar(30)
  email        String?      @db.VarChar(150)
  website      String?      @db.VarChar(200)
  directorName String?      @map("director_name") @db.VarChar(150)
  logoUrl      String?      @map("logo_url")
  motto        String?      @db.VarChar(200)
  createdYear  Int?         @map("created_year") @db.SmallInt
  tutelleInfo  String?      @map("tutelle_info")
  isActive     Boolean      @default(true) @map("is_active")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  academicYears       AcademicYear[]
  levels              Level[]
  rooms               Room[]
  classes             Class[]
  setting             Setting?
  users               User[]
  students            Student[]
  guardians           Guardian[]
  teachers            Teacher[]
  subjects            Subject[]
  assessments         Assessment[]
  timetableSlots      TimetableSlot[]
  feesTypes           FeeType[]
  feeStructures       FeeStructure[]
  invoices            Invoice[]
  payments            Payment[]
  cashSessions        CashSession[]
  documentTemplates   DocumentTemplate[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  backups             Backup[]
  expenseCategories   ExpenseCategory[]
  expenses            Expense[]

  @@map("schools")
}

model AcademicYear {
  id          String             @id @default(uuid()) @db.Uuid
  schoolId    String             @map("school_id") @db.Uuid
  label       String             @db.VarChar(20)
  startDate   DateTime           @map("start_date") @db.Date
  endDate     DateTime           @map("end_date") @db.Date
  status      AcademicYearStatus @default(PREPARATION)
  isCurrent   Boolean            @default(false) @map("is_current")
  closedAt    DateTime?          @map("closed_at") @db.Timestamptz
  archivedAt  DateTime?          @map("archived_at") @db.Timestamptz
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  school            School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  terms             Term[]
  classes           Class[]
  enrollments       Enrollment[]
  pathways          StudentPathway[]
  assignments       TeacherAssignment[]
  timetableSlots    TimetableSlot[]
  assessments       Assessment[]
  reportCards       ReportCard[]
  exams             Exam[]
  feeStructures     FeeStructure[]
  invoices          Invoice[]

  @@unique([schoolId, label])
  @@index([schoolId, status])
  @@map("academic_years")
}

model Term {
  id             String    @id @default(uuid()) @db.Uuid
  academicYearId String    @map("academic_year_id") @db.Uuid
  name           String    @db.VarChar(50)
  type           TermType
  startDate      DateTime  @map("start_date") @db.Date
  endDate        DateTime  @map("end_date") @db.Date
  orderIndex     Int       @map("order_index") @db.SmallInt
  isLocked       Boolean   @default(false) @map("is_locked")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  academicYear       AcademicYear        @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  attendanceSessions AttendanceSession[]
  assessments        Assessment[]
  reportCards        ReportCard[]
  exams              Exam[]

  @@index([academicYearId])
  @@map("terms")
}

model Level {
  id         String     @id @default(uuid()) @db.Uuid
  schoolId   String     @map("school_id") @db.Uuid
  cycle      LevelCycle
  name       String     @db.VarChar(50)
  code       String     @db.VarChar(20)
  orderIndex Int        @map("order_index") @db.SmallInt
  isActive   Boolean    @default(true) @map("is_active")
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  school              School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classes             Class[]
  enrollments         Enrollment[]
  pathways            StudentPathway[]
  subjectCoefficients SubjectCoefficient[]
  feeStructures       FeeStructure[]

  @@unique([schoolId, code])
  @@index([schoolId, cycle])
  @@map("levels")
}

model Room {
  id          String    @id @default(uuid()) @db.Uuid
  schoolId    String    @map("school_id") @db.Uuid
  name        String    @db.VarChar(80)
  type        RoomType
  capacity    Int?      @db.SmallInt
  location    String?   @db.VarChar(120)
  equipment   Json?
  isAvailable Boolean   @default(true) @map("is_available")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  school         School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classes        Class[]
  timetableSlots TimetableSlot[]
  examSessions   ExamSession[]

  @@index([schoolId])
  @@map("rooms")
}

model Class {
  id             String      @id @default(uuid()) @db.Uuid
  schoolId       String      @map("school_id") @db.Uuid
  academicYearId String      @map("academic_year_id") @db.Uuid
  levelId        String      @map("level_id") @db.Uuid
  code           String      @db.VarChar(30)
  name           String      @db.VarChar(100)
  roomId         String?     @map("room_id") @db.Uuid
  capacity       Int?        @db.SmallInt
  mainTeacherId  String?     @map("main_teacher_id") @db.Uuid
  status         ClassStatus @default(OPEN)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  school             School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear       AcademicYear        @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  level              Level               @relation(fields: [levelId], references: [id])
  room               Room?               @relation(fields: [roomId], references: [id])
  mainTeacher        Teacher?            @relation("ClassMainTeacher", fields: [mainTeacherId], references: [id])
  enrollments        Enrollment[]
  pathways           StudentPathway[]
  assignments        TeacherAssignment[]
  timetableSlots     TimetableSlot[]
  attendanceSessions AttendanceSession[]
  assessments        Assessment[]
  reportCards        ReportCard[]
  examSessions       ExamSession[]

  @@unique([academicYearId, code])
  @@index([schoolId])
  @@index([levelId])
  @@map("classes")
}

model Setting {
  id           String   @id @default(uuid()) @db.Uuid
  schoolId     String   @unique @map("school_id") @db.Uuid
  currency     String   @default("FCFA") @db.VarChar(10)
  locale       String   @default("fr-FR") @db.VarChar(10)
  timezone     String   @default("Africa/Bamako") @db.VarChar(50)
  gradingScale Decimal  @default(20) @map("grading_scale") @db.Decimal(5, 2)
  passMark     Decimal  @default(10) @map("pass_mark") @db.Decimal(5, 2)
  data         Json?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("settings")
}


// ============================================================
// 2. BLOC UTILISATEURS & SECURITE
// ============================================================

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  schoolId           String?    @map("school_id") @db.Uuid
  email              String?    @unique @db.VarChar(150)
  phone              String?    @unique @db.VarChar(30)
  passwordHash       String     @map("password_hash")
  firstName          String     @map("first_name") @db.VarChar(100)
  lastName           String     @map("last_name") @db.VarChar(100)
  status             UserStatus @default(ACTIVE)
  lastLoginAt        DateTime?  @map("last_login_at") @db.Timestamptz
  failedAttempts     Int        @default(0) @map("failed_attempts") @db.SmallInt
  lockedUntil        DateTime?  @map("locked_until") @db.Timestamptz
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  twoFactorSecret    String?    @map("two_factor_secret")
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  school             School?             @relation(fields: [schoolId], references: [id])
  userRoles          UserRole[]
  refreshTokens      RefreshToken[]
  authLogs           AuthLog[]
  guardian           Guardian?
  teacher            Teacher?
  paymentsCashier    Payment[]           @relation("PaymentCashier")
  gradesEntered      Grade[]             @relation("GradeEnteredBy")
  documentsGenerated GeneratedDocument[] @relation("DocumentGeneratedBy")
  backupsCreated     Backup[]            @relation("BackupCreatedBy")
  expensesMade       Expense[]           @relation("ExpenseCashier")
  cashSessionsOpened CashSession[]      @relation("CashSessionCashier")

  @@index([schoolId])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(80)
  module      String   @db.VarChar(50)
  action      String   @db.VarChar(30)
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId   String  @map("user_id") @db.Uuid
  roleId   String  @map("role_id") @db.Uuid
  schoolId String? @map("school_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address") @db.Inet
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model AuthLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  login     String?  @db.VarChar(150)
  success   Boolean
  ipAddress String?  @map("ip_address") @db.Inet
  userAgent String?  @map("user_agent")
  reason    String?  @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@map("auth_logs")
}

// ============================================================
// 3. BLOC ELEVES & PARENTS
// ============================================================

model Student {
  id               String        @id @default(uuid()) @db.Uuid
  schoolId         String        @map("school_id") @db.Uuid
  matricule        String        @db.VarChar(30)
  firstName        String        @map("first_name") @db.VarChar(100)
  lastName         String        @map("last_name") @db.VarChar(100)
  gender           Gender
  birthDate        DateTime      @map("birth_date") @db.Date
  birthPlace       String?       @map("birth_place") @db.VarChar(150)
  nationality      String?       @db.VarChar(80)
  photoUrl         String?       @map("photo_url")
  phone            String?       @db.VarChar(30)
  address          String?
  specialSituation String?       @map("special_situation")
  status           StudentStatus @default(ACTIVE)
  deletedAt        DateTime?     @map("deleted_at") @db.Timestamptz
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  school             School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  guardians          StudentGuardian[]
  documents          StudentDocument[]
  enrollments        Enrollment[]
  pathways           StudentPathway[]
  attendanceRecords  AttendanceRecord[]
  grades             Grade[]
  reportCards        ReportCard[]
  examCandidates     ExamCandidate[]
  invoices           Invoice[]
  payments           Payment[]
  generatedDocuments GeneratedDocument[]
  transfers          StudentTransfer[]

  @@unique([schoolId, matricule])
  @@index([schoolId])
  @@index([lastName, firstName])
  @@map("students")
}

model Guardian {
  id           String           @id @default(uuid()) @db.Uuid
  schoolId     String           @map("school_id") @db.Uuid
  userId       String?          @unique @map("user_id") @db.Uuid
  firstName    String           @map("first_name") @db.VarChar(100)
  lastName     String           @map("last_name") @db.VarChar(100)
  gender       Gender?
  phone        String           @db.VarChar(30)
  email        String?          @db.VarChar(150)
  address      String?
  profession   String?          @db.VarChar(120)
  relationType GuardianRelation @map("relation_type")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  school        School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user          User?             @relation(fields: [userId], references: [id])
  students      StudentGuardian[]
  notifications Notification[]

  @@index([schoolId])
  @@map("guardians")
}

model StudentGuardian {
  studentId  String  @map("student_id") @db.Uuid
  guardianId String  @map("guardian_id") @db.Uuid
  isPrimary  Boolean @default(false) @map("is_primary")

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@id([studentId, guardianId])
  @@map("student_guardians")
}

model StudentDocument {
  id         String       @id @default(uuid()) @db.Uuid
  studentId  String       @map("student_id") @db.Uuid
  type       DocumentType
  fileUrl    String       @map("file_url")
  fileName   String?      @map("file_name") @db.VarChar(200)
  mimeType   String?      @map("mime_type") @db.VarChar(100)
  sizeBytes  Int?         @map("size_bytes")
  uploadedAt DateTime     @default(now()) @map("uploaded_at") @db.Timestamptz
  uploadedBy String?      @map("uploaded_by") @db.Uuid

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("student_documents")
}

model Enrollment {
  id             String           @id @default(uuid()) @db.Uuid
  studentId      String           @map("student_id") @db.Uuid
  academicYearId String           @map("academic_year_id") @db.Uuid
  classId        String           @map("class_id") @db.Uuid
  levelId        String           @map("level_id") @db.Uuid
  enrollmentDate DateTime         @default(now()) @map("enrollment_date") @db.Date
  status         EnrollmentStatus @default(PENDING)
  previousSchool String?          @map("previous_school") @db.VarChar(200)
  notes          String?
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  class        Class        @relation(fields: [classId], references: [id])
  level        Level        @relation(fields: [levelId], references: [id])

  @@unique([studentId, academicYearId])
  @@index([academicYearId, status])
  @@map("enrollments")
}

model StudentPathway {
  id             String         @id @default(uuid()) @db.Uuid
  studentId      String         @map("student_id") @db.Uuid
  academicYearId String         @map("academic_year_id") @db.Uuid
  levelId        String         @map("level_id") @db.Uuid
  classId        String         @map("class_id") @db.Uuid
  result         PathwayResult?
  decision       String?        @db.VarChar(80)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  level        Level        @relation(fields: [levelId], references: [id])
  class        Class        @relation(fields: [classId], references: [id])

  @@index([studentId])
  @@map("student_pathways")
}

// ============================================================
// 4. BLOC ENSEIGNANTS & MATIERES
// ============================================================

model Teacher {
  id           String        @id @default(uuid()) @db.Uuid
  schoolId     String        @map("school_id") @db.Uuid
  userId       String?       @unique @map("user_id") @db.Uuid
  matricule    String        @db.VarChar(30)
  firstName    String        @map("first_name") @db.VarChar(100)
  lastName     String        @map("last_name") @db.VarChar(100)
  gender       Gender?
  phone        String?       @db.VarChar(30)
  email        String?       @db.VarChar(150)
  address      String?
  specialty    String?       @db.VarChar(120)
  diploma      String?       @db.VarChar(150)
  hireDate     DateTime?     @map("hire_date") @db.Date
  status       TeacherStatus @default(ACTIVE)
  contractType ContractType? @map("contract_type")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  school                  School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user                    User?               @relation(fields: [userId], references: [id])
  mainTeacherClasses      Class[]             @relation("ClassMainTeacher")
  assignments             TeacherAssignment[]
  timetableSlots          TimetableSlot[]
  attendanceSessions      AttendanceSession[]
  assessments             Assessment[]
  examSessionsSupervised  ExamSession[]       @relation("ExamSupervisor")

  @@unique([schoolId, matricule])
  @@index([schoolId])
  @@map("teachers")
}

model Subject {
  id        String      @id @default(uuid()) @db.Uuid
  schoolId  String      @map("school_id") @db.Uuid
  code      String      @db.VarChar(20)
  name      String      @db.VarChar(120)
  type      SubjectType @default(CORE)
  isActive  Boolean     @default(true) @map("is_active")
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  school              School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  coefficients        SubjectCoefficient[]
  assignments         TeacherAssignment[]
  timetableSlots      TimetableSlot[]
  attendanceSessions  AttendanceSession[]
  assessments         Assessment[]
  reportCardItems     ReportCardItem[]
  examSessions        ExamSession[]

  @@unique([schoolId, code])
  @@map("subjects")
}

model SubjectCoefficient {
  id          String   @id @default(uuid()) @db.Uuid
  subjectId   String   @map("subject_id") @db.Uuid
  levelId     String   @map("level_id") @db.Uuid
  coefficient Decimal  @db.Decimal(4, 2)
  weeklyHours Decimal? @map("weekly_hours") @db.Decimal(4, 1)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  level   Level   @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@unique([subjectId, levelId])
  @@map("subject_coefficients")
}

model TeacherAssignment {
  id             String   @id @default(uuid()) @db.Uuid
  teacherId      String   @map("teacher_id") @db.Uuid
  subjectId      String   @map("subject_id") @db.Uuid
  classId        String   @map("class_id") @db.Uuid
  academicYearId String   @map("academic_year_id") @db.Uuid
  isMain         Boolean  @default(false) @map("is_main")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  teacher      Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject      Subject      @relation(fields: [subjectId], references: [id])
  class        Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  @@unique([teacherId, subjectId, classId, academicYearId])
  @@index([classId])
  @@map("teacher_assignments")
}

