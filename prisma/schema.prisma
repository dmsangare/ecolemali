// 7. BLOC EVALUATIONS, NOTES, BULLETINS
// ============================================================

model Assessment {
  id             String           @id @default(uuid()) @db.Uuid
  schoolId       String           @map("school_id") @db.Uuid
  academicYearId String           @map("academic_year_id") @db.Uuid
  termId         String           @map("term_id") @db.Uuid
  classId        String           @map("class_id") @db.Uuid
  subjectId      String           @map("subject_id") @db.Uuid
  teacherId      String           @map("teacher_id") @db.Uuid
  type           AssessmentType
  title          String           @db.VarChar(150)
  date           DateTime         @db.Date
  maxScore       Decimal          @map("max_score") @db.Decimal(5, 2)
  coefficient    Decimal          @default(1) @db.Decimal(4, 2)
  durationMin    Int?             @map("duration_min") @db.SmallInt
  status         AssessmentStatus @default(DRAFT)
  observation    String?
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  term         Term         @relation(fields: [termId], references: [id])
  class        Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject      Subject      @relation(fields: [subjectId], references: [id])
  teacher      Teacher      @relation(fields: [teacherId], references: [id])
  grades       Grade[]

  @@index([classId, termId])
  @@index([subjectId])
  @@map("assessments")
}

model Grade {
  id           String   @id @default(uuid()) @db.Uuid
  assessmentId String   @map("assessment_id") @db.Uuid
  studentId    String   @map("student_id") @db.Uuid
  value        Decimal? @db.Decimal(5, 2)
  isAbsent     Boolean  @default(false) @map("is_absent")
  observation  String?
  enteredBy    String?  @map("entered_by") @db.Uuid
  locked       Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  assessment    Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student       Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enteredByUser User?      @relation("GradeEnteredBy", fields: [enteredBy], references: [id])

  @@unique([assessmentId, studentId])
  @@index([studentId])
  @@map("grades")
}

model ReportCard {
  id             String          @id @default(uuid()) @db.Uuid
  studentId      String          @map("student_id") @db.Uuid
  classId        String          @map("class_id") @db.Uuid
  termId         String          @map("term_id") @db.Uuid
  academicYearId String          @map("academic_year_id") @db.Uuid
  average        Decimal?        @db.Decimal(5, 2)
  rank           Int?            @db.SmallInt
  classSize      Int?            @map("class_size") @db.SmallInt
  decision       ReportDecision?
  appreciation   String?
  absencesCount  Int             @default(0) @map("absences_count") @db.SmallInt
  latesCount     Int             @default(0) @map("lates_count") @db.SmallInt
  status         ReportStatus    @default(DRAFT)
  publishedAt    DateTime?       @map("published_at") @db.Timestamptz
  pdfUrl         String?         @map("pdf_url")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  student      Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class        Class            @relation(fields: [classId], references: [id])
  term         Term             @relation(fields: [termId], references: [id])
  academicYear AcademicYear     @relation(fields: [academicYearId], references: [id])
  items        ReportCardItem[]

  @@unique([studentId, termId])
  @@index([classId, termId])
  @@map("report_cards")
}

model ReportCardItem {
  id             String   @id @default(uuid()) @db.Uuid
  reportCardId   String   @map("report_card_id") @db.Uuid
  subjectId      String   @map("subject_id") @db.Uuid
  average        Decimal? @db.Decimal(5, 2)
  coefficient    Decimal  @db.Decimal(4, 2)
  weighted       Decimal? @db.Decimal(7, 2)
  rank           Int?     @db.SmallInt
  teacherComment String?  @map("teacher_comment")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  reportCard ReportCard @relation(fields: [reportCardId], references: [id], onDelete: Cascade)
  subject    Subject    @relation(fields: [subjectId], references: [id])

  @@index([reportCardId])
  @@map("report_card_items")
}


