  school  School             @relation("SchoolExamDossiers", fields: [schoolId], references: [id], onDelete: Cascade)
  class   Class              @relation("ClassExamDossiers", fields: [classId], references: [id], onDelete: Cascade)
  level   Level              @relation("LevelExamDossiers", fields: [levelId], references: [id], onDelete: Cascade)
  pieces  ExamDossierPiece[]

  @@unique([sessionId, classId])
  @@index([schoolId])
  @@index([sessionId])
  @@index([status])
  @@map("exam_dossiers")
}

model ExamDossierPiece {
  id         String    @id @default(uuid()) @db.Uuid
  dossierId  String    @map("dossier_id") @db.Uuid
  studentId  String    @map("student_id") @db.Uuid
  pieceType  String    @map("piece_type") @db.VarChar(60)
  isPresent  Boolean   @default(false) @map("is_present")
  fileUrl    String?   @map("file_url") @db.VarChar(500)
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz
  verifiedBy String?   @map("verified_by") @db.Uuid
  notes      String?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  dossier ExamDossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  student Student     @relation("StudentExamDossierPieces", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([dossierId, studentId, pieceType])
  @@index([dossierId])
  @@index([studentId])
  @@map("exam_dossier_pieces")
}

// ============================================================
// INVOICE INSTALLMENT (echeancier)
// ============================================================

model InvoiceInstallment {
  id         String            @id @default(uuid()) @db.Uuid
  invoiceId  String            @map("invoice_id") @db.Uuid
  label      String            @db.VarChar(100)
  amount     Decimal           @db.Decimal(14, 2)
  paidAmount Decimal           @default(0) @map("paid_amount") @db.Decimal(14, 2)
  dueDate    DateTime?         @map("due_date") @db.Date
  status     InstallmentStatus @default(PENDING)
  orderIndex Int               @default(0) @map("order_index") @db.SmallInt
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  invoice  Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([invoiceId])
  @@index([status])
  @@index([dueDate])
  @@map("invoice_installments")
}

// BLOC 6 — Nouveaux modèles (additif)
model SubjectDomain {
  id        String    @id @default(uuid()) @db.Uuid
  schoolId  String    @map("school_id") @db.Uuid
  name      String    @db.VarChar(100)
  code      String    @db.VarChar(50)
  order     Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at")
  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subjects  Subject[]

  @@unique([schoolId, code])
  @@map("subject_domains")
}

model GradeAudit {
  id        String   @id @default(uuid()) @db.Uuid
  gradeId   String   @map("grade_id") @db.Uuid
  oldValue  Decimal? @map("old_value") @db.Decimal(5, 2)
  newValue  Decimal? @map("new_value") @db.Decimal(5, 2)
  userId    String   @map("user_id") @db.Uuid
  motive    String?
  createdAt DateTime @default(now()) @map("created_at")
  grade     Grade    @relation(fields: [gradeId], references: [id], onDelete: Cascade)

  @@map("grade_audits")
}

