model Exam {
  id             String     @id @default(uuid()) @db.Uuid
  schoolId       String     @map("school_id") @db.Uuid
  academicYearId String     @map("academic_year_id") @db.Uuid
  termId         String?    @map("term_id") @db.Uuid
  type           ExamType
  name           String     @db.VarChar(150)
  startDate      DateTime   @map("start_date") @db.Date
  endDate        DateTime   @map("end_date") @db.Date
  status         ExamStatus @default(PLANNED)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  academicYear AcademicYear  @relation(fields: [academicYearId], references: [id])
  term         Term?         @relation(fields: [termId], references: [id])
  sessions     ExamSession[]

  @@index([schoolId])
  @@map("exams")
}

model ExamSession {
  id           String   @id @default(uuid()) @db.Uuid
  examId       String   @map("exam_id") @db.Uuid
  subjectId    String   @map("subject_id") @db.Uuid
  classId      String   @map("class_id") @db.Uuid
  roomId       String?  @map("room_id") @db.Uuid
  supervisorId String?  @map("supervisor_id") @db.Uuid
  date         DateTime @db.Date
  startTime    DateTime @map("start_time") @db.Time
  endTime      DateTime @map("end_time") @db.Time
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  exam       Exam            @relation(fields: [examId], references: [id], onDelete: Cascade)
  subject    Subject         @relation(fields: [subjectId], references: [id])
  class      Class           @relation(fields: [classId], references: [id])
  room       Room?           @relation(fields: [roomId], references: [id])
  supervisor Teacher?        @relation("ExamSupervisor", fields: [supervisorId], references: [id])
  candidates ExamCandidate[]

  @@index([examId])
  @@map("exam_sessions")
}

model ExamCandidate {
  id            String   @id @default(uuid()) @db.Uuid
  examSessionId String   @map("exam_session_id") @db.Uuid
  studentId     String   @map("student_id") @db.Uuid
  isPresent     Boolean? @map("is_present")
  score         Decimal? @db.Decimal(5, 2)
  observation   String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  examSession ExamSession @relation(fields: [examSessionId], references: [id], onDelete: Cascade)
  student     Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([examSessionId, studentId])
  @@map("exam_candidates")
}

// ============================================================
// 9. BLOC FINANCES
// ============================================================

model FeeType {
  id        String      @id @default(uuid()) @db.Uuid
  schoolId  String      @map("school_id") @db.Uuid
  code      String      @db.VarChar(30)
  name      String      @db.VarChar(120)
  category  FeeCategory
  isActive  Boolean     @default(true) @map("is_active")
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  feeStructures FeeStructure[]
  invoiceItems  InvoiceItem[]

  @@unique([schoolId, code])
  @@map("fee_types")
}

model FeeStructure {
  id             String    @id @default(uuid()) @db.Uuid
  schoolId       String    @map("school_id") @db.Uuid
  academicYearId String    @map("academic_year_id") @db.Uuid
  levelId        String?   @map("level_id") @db.Uuid
  feeTypeId      String    @map("fee_type_id") @db.Uuid
  amount         Decimal   @db.Decimal(14, 2)
  dueDate        DateTime? @map("due_date") @db.Date
  installments   Int       @default(1) @db.SmallInt
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  level        Level?       @relation(fields: [levelId], references: [id])
  feeType      FeeType      @relation(fields: [feeTypeId], references: [id])

  @@index([schoolId, academicYearId])
  @@map("fee_structures")
}

model Invoice {
  id                String          @id @default(uuid()) @db.Uuid
  schoolId          String          @map("school_id") @db.Uuid
  studentId         String          @map("student_id") @db.Uuid
  academicYearId    String          @map("academic_year_id") @db.Uuid
  number            String          @db.VarChar(30)
  issuedAt          DateTime        @default(now()) @map("issued_at") @db.Date
  dueDate           DateTime?       @map("due_date") @db.Date
  totalAmount       Decimal         @map("total_amount") @db.Decimal(14, 2)
  paidAmount        Decimal         @default(0) @map("paid_amount") @db.Decimal(14, 2)
  balance           Decimal         @default(0) @db.Decimal(14, 2)
  status            InvoiceStatus   @default(UNPAID)
  kind              InvoiceKind     @default(REGULAR)
  installmentMode   InstallmentMode @default(CASH) @map("installment_mode")
  carriedOverFromId String?         @map("carried_over_from_id") @db.Uuid
  cancelledAt       DateTime?       @map("cancelled_at") @db.Timestamptz
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  school       School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student      Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear AcademicYear         @relation(fields: [academicYearId], references: [id])
  items        InvoiceItem[]
  payments     Payment[]
  installments InvoiceInstallment[]
  messageLogs  MessageLog[]

  @@unique([schoolId, number])
  @@index([studentId])
  @@index([schoolId, status])
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(uuid()) @db.Uuid
  invoiceId   String   @map("invoice_id") @db.Uuid
  feeTypeId   String   @map("fee_type_id") @db.Uuid
  description String?  @db.VarChar(200)
  quantity    Int      @default(1) @db.SmallInt
  unitAmount  Decimal  @map("unit_amount") @db.Decimal(14, 2)
  totalAmount Decimal  @map("total_amount") @db.Decimal(14, 2)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  feeType FeeType @relation(fields: [feeTypeId], references: [id])

  @@map("invoice_items")
}

model Payment {
  cashSessionId  String?       @map("cash_session_id") @db.Uuid
  cashSession    CashSession?  @relation(fields: [cashSessionId], references: [id])
  id             String        @id @default(uuid()) @db.Uuid
  schoolId       String        @map("school_id") @db.Uuid
  invoiceId      String        @map("invoice_id") @db.Uuid
  studentId      String        @map("student_id") @db.Uuid
  amount         Decimal       @db.Decimal(14, 2)
  method         PaymentMethod
  reference      String?       @db.VarChar(80)
  paidAt         DateTime      @default(now()) @map("paid_at") @db.Timestamptz
  cashierId      String?       @map("cashier_id") @db.Uuid
  installmentId  String?       @map("installment_id") @db.Uuid
  importedFrom   String?       @map("imported_from") @db.VarChar(80)
  note           String?       @db.Text
  cancelledAt    DateTime?     @map("cancelled_at") @db.Timestamptz
  cancelReason   String?       @map("cancel_reason")
  idempotencyKey String?       @map("idempotency_key") @db.VarChar(80)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  school      School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  invoice     Invoice             @relation(fields: [invoiceId], references: [id])
  student     Student             @relation(fields: [studentId], references: [id])
  cashier     User?               @relation("PaymentCashier", fields: [cashierId], references: [id])
  installment InvoiceInstallment? @relation(fields: [installmentId], references: [id], onDelete: SetNull)
  receipt     Receipt?

  @@unique([schoolId, idempotencyKey], name: "unique_idempotency_per_school")
  @@index([invoiceId])
  @@index([studentId])
  @@index([paidAt])
  @@index([installmentId])
  @@map("payments")
}

model Receipt {
  id        String   @id @default(uuid()) @db.Uuid
  paymentId String   @unique @map("payment_id") @db.Uuid
  number    String   @unique @db.VarChar(30)
  issuedAt  DateTime @default(now()) @map("issued_at") @db.Timestamptz
  pdfUrl    String?  @map("pdf_url")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@map("receipts")
}

model CashSession {
  payments       Payment[]
  id             String     @id @default(uuid()) @db.Uuid
  schoolId       String     @map("school_id") @db.Uuid
  cashierId      String     @map("cashier_id") @db.Uuid
  openedAt       DateTime   @default(now()) @map("opened_at") @db.Timestamptz
  closedAt       DateTime?  @map("closed_at") @db.Timestamptz
  openingAmount  Decimal    @default(0) @map("opening_amount") @db.Decimal(14, 2)
  closingAmount  Decimal?   @map("closing_amount") @db.Decimal(14, 2)
  expectedAmount Decimal?   @map("expected_amount") @db.Decimal(14, 2)
  difference     Decimal?   @db.Decimal(14, 2)
  status         CashStatus @default(OPEN)
