// ============================================================
// BLOC A — Verification QR (fondations)
// Chaque document signé (carte, bulletin, recu, attestation...)
// possede un short code unique + une signature HMAC pour
// verification publique via QR code.
// ============================================================
model StudentAccount {
  id        String @id @default(uuid()) @db.Uuid
  studentId String @unique @map("student_id") @db.Uuid
  schoolId  String @map("school_id") @db.Uuid

  // creditBalance > 0 => l'ecole doit de l'argent a l'eleve
  creditBalance Decimal @default(0) @map("credit_balance") @db.Decimal(14, 2)
  // debtBalance > 0 => l'eleve doit de l'argent a l'ecole
  debtBalance   Decimal @default(0) @map("debt_balance") @db.Decimal(14, 2)

  lastCreditAt DateTime? @map("last_credit_at") @db.Timestamptz
  lastDebtAt   DateTime? @map("last_debt_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, creditBalance])
  @@index([schoolId, debtBalance])
  @@map("student_accounts")
}

model VerifiableDocument {
  id          String    @id @default(uuid()) @db.Uuid
  schoolId    String    @map("school_id") @db.Uuid
  type        String    @db.VarChar(30) // BULLETIN | RECEIPT | ID_CARD | ATTESTATION | CERTIFICATE
  referenceId String    @map("reference_id") @db.Uuid
  shortCode   String    @unique @map("short_code") @db.VarChar(12)
  hmacToken   String    @map("hmac_token") @db.VarChar(64)
  meta        Json? // infos utiles (matricule, nom, classe...) pour verif offline
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz
  revokedBy   String?   @map("revoked_by") @db.Uuid
  viewCount   Int       @default(0) @map("view_count")
  lastViewAt  DateTime? @map("last_view_at") @db.Timestamptz
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, type])
  @@index([shortCode])
  @@index([referenceId])
  @@map("verifiable_documents")
}

