  fileUrl   String       @map("file_url")
  sizeBytes BigInt?      @map("size_bytes")
  createdBy String?      @map("created_by") @db.Uuid
  status    BackupStatus @default(SUCCESS)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz

  school        School? @relation(fields: [schoolId], references: [id])
  createdByUser User?   @relation("BackupCreatedBy", fields: [createdBy], references: [id])

  @@map("backups")
}

model SystemLog {
  id        BigInt   @id @default(autoincrement())
  level     String   @db.VarChar(10)
  module    String?  @db.VarChar(50)
  message   String
  context   Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([level, createdAt])
  @@map("system_logs")
}

// ============================================================
// 12. BLOC TRANSFERTS
// ============================================================

model StudentTransfer {
  id                    String         @id @default(uuid()) @db.Uuid
  studentId             String         @map("student_id") @db.Uuid
  type                  TransferType
  fromSchool            String?        @map("from_school") @db.VarChar(200)
  fromSchoolAddress     String?        @map("from_school_address") @db.VarChar(200)
  fromSchoolPhone       String?        @map("from_school_phone") @db.VarChar(30)
  fromSchoolDirector    String?        @map("from_school_director") @db.VarChar(150)
  toSchool              String?        @map("to_school") @db.VarChar(200)
  toSchoolAddress       String?        @map("to_school_address") @db.VarChar(200)
  toSchoolPhone         String?        @map("to_school_phone") @db.VarChar(30)
  toSchoolDirector      String?        @map("to_school_director") @db.VarChar(150)
  reason                TransferReason
  reasonDetails         String?        @map("reason_details")
  effectiveDate         DateTime       @map("effective_date") @db.Date
  certificateUrl        String?        @map("certificate_url")
  previousMatricule     String?        @map("previous_matricule") @db.VarChar(30)
  previousClassLevel    String?        @map("previous_class_level") @db.VarChar(50)
  previousAverage       Decimal?       @map("previous_average") @db.Decimal(5, 2)
  decision              String?        @db.VarChar(150)
  verificationCode      String         @unique @map("verification_code") @db.VarChar(20)
  status                TransferStatus @default(PENDING)
  verifiedAt            DateTime?      @map("verified_at") @db.Timestamptz
  verifiedBy            String?        @map("verified_by") @db.Uuid
  notes                 String?
  createdBy             String?        @map("created_by") @db.Uuid
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([type, status])
  @@index([verificationCode])
  @@map("student_transfers")
}

// ============================================================
// 16. BLOC DEPENSES
// ============================================================

model ExpenseCategory {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String   @map("school_id") @db.Uuid
  code        String   @db.VarChar(50)
  name        String   @db.VarChar(120)
  description String?
  emoji       String?  @db.VarChar(10)
  isActive    Boolean  @default(true) @map("is_active")
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  school   School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@unique([schoolId, code])
  @@index([schoolId, isActive])
  @@map("expense_categories")
}

model Expense {
  id             String   @id @default(uuid()) @db.Uuid
  schoolId       String   @map("school_id") @db.Uuid
  categoryId     String   @map("category_id") @db.Uuid
  cashierId      String   @map("cashier_id") @db.Uuid
  cashSessionId  String?  @map("cash_session_id") @db.Uuid
  amount         Decimal  @db.Decimal(14, 2)
  description    String
  beneficiary    String?  @db.VarChar(150)
  receiptUrl     String?  @map("receipt_url")
  spentAt        DateTime @default(now()) @map("spent_at") @db.Timestamptz
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  school      School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  category    ExpenseCategory @relation(fields: [categoryId], references: [id])
  cashier     User            @relation("ExpenseCashier", fields: [cashierId], references: [id])
  cashSession CashSession?    @relation(fields: [cashSessionId], references: [id])

  @@index([schoolId, spentAt])
  @@index([cashSessionId])
  @@index([categoryId])
  @@map("expenses")
}
